{
  "name": "lightbar-dock",
  "version": "1.0.0",
  "description": "A 1x8 USB-C charging dock for stick-anywhere rechargeable light bars. Bars plug vertically onto upward-facing USB-C plugs; a green LED per port shows live charging status (actual current flow, not just power present).",
  "type": "module",
  "main": "circuit/index.circuit.tsx",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "import:kicad": "bun scripts/import-kicad.mjs",
    "build:circuit": "bun scripts/build-circuit.mjs",
    "route:pcbkit": "bun run pcbkit:route",
    "route:board": "bun scripts/route-board-pcbkit.mjs",
    "board:make": "bun scripts/board-make.mjs",
    "board:make:route": "bun scripts/board-make.mjs --route-only",
    "board:make:drc": "bun scripts/board-make.mjs --skip-route",
    "board:make:pin": "bun scripts/board-make.mjs --pin",
    "dsn:check": "bun scripts/check-dsn-fresh.mjs",
    "dsn:export": "bun scripts/export-dsn.mjs",
    "for-route:promote": "bun scripts/promote-for-route.mjs",
    "fix:silk": "bun scripts/fix-silk-hygiene.mjs",
    "fix:fp-lib": "bun scripts/strip-fp-supplier-pn.mjs && bun scripts/update-board-fps-from-lib.mjs",
    "pcbkit:build": "cargo build --release --manifest-path pcbkit/Cargo.toml",
    "pcbkit:check": "pcbkit/target/release/pcbkit check -i build/lightbar-dock.circuit.json",
    "pcbkit:route": "bun scripts/route-pcbkit.mjs",
    "pcbkit:route-board": "bun scripts/route-board-pcbkit.mjs",
    "pcbkit:smoke": "bun run pcbkit:build && pcbkit/target/release/pcbkit route -i build/lightbar-dock.circuit.json -p pcbkit/profiles/smoke.toml -o build/lightbar-dock.pcbkit-smoke.circuit.json --allow-fail",
    "ensure:java": "bun scripts/ensure-java.mjs",
    "autoroute:pcbkit": "bun packages/pcbkit-tscircuit/server.mjs --profile pcbkit/profiles/lightbar-dock-circuit.toml",
    "autoroute:server": "bun packages/topola-autorouter/server.mjs",
    "smoke:autoroute": "bun scripts/smoke-autoroute.mjs",
    "setup:toolchain": "bash scripts/setup-toolchain.sh",
    "check:netlist": "tsci check netlist circuit/index.circuit.tsx",
    "check:pins": "tsci check pin_specification circuit/index.circuit.tsx",
    "check:placement": "tsci check placement circuit/index.circuit.tsx",
    "check:circuit": "bun run check:netlist && bun run check:pins && bun run check:placement",
    "typecheck": "tsc --noEmit",
    "test:firmware": "cc -std=c11 -Wall -Wextra -Werror -Ifirmware/status-controller/include firmware/status-controller/src/status_logic.c firmware/status-controller/test/status_logic_test.c -o /tmp/lightbar-status-test && /tmp/lightbar-status-test",
    "test": "bun run typecheck && bun run test:firmware",
    "export:kicad": "bun scripts/export-kicad.mjs",
    "verify:electrical": "bun scripts/verify-electrical.mjs",
    "verify:vias": "bun scripts/assert-via-sizes.mjs",
    "verify": "bun run test && bun run check:circuit && bun run build:circuit && bun run verify:electrical && bun run verify:vias",
    "verify:ci": "bun run typecheck && bun run test:firmware && bun run check:netlist > /tmp/tsci-netlist.txt && bun run check:pins > /tmp/tsci-pins.txt && bun run check:placement > /tmp/tsci-placement.txt && bun run build:circuit && bun run verify:electrical && bun run verify:vias && bun run dsn:check",
    "pcbkit:assure": "pcbkit/target/release/pcbkit assure -i build/lightbar-dock.circuit.json --pcb ci/artifacts/v3-manufacturing.kicad_pcb",
    "pcbkit:attach-3d": "mkdir -p generated/kicad && pcbkit/target/release/pcbkit attach-3d --pcb ci/artifacts/v3-manufacturing.kicad_pcb -o generated/kicad/v3-manufacturing-3d.kicad_pcb && bun scripts/make-3d-kicad-pro.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/djmango/lightbar-dock.git"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/djmango/lightbar-dock/issues"
  },
  "homepage": "https://github.com/djmango/lightbar-dock#readme",
  "dependencies": {
    "@tscircuit/core": "0.0.1450",
    "@tscircuit/eval": "0.0.1015",
    "circuit-json-to-connectivity-map": "0.0.25",
    "circuit-json-to-kicad": "^0.0.170",
    "kicad-to-circuit-json": "0.0.113",
    "polygon-clipping": "^0.15.7",
    "tscircuit": "0.0.2096"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "19.2.17",
    "typescript": "5.9.3"
  }
}
